# Environment Variables - SMKN 10 Makassar Sistem Inventaris & Peminjaman

# PostgreSQL Connection String (Supabase / Vercel Postgres / Neon / Local)
# Format Supabase: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inventaris_smkn10?schema=public"

# Direct URL for migrations (bypassing connection pooler on Supabase)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/inventaris_smkn10?schema=public"

# JWT Secret for Auth Cookies
JWT_SECRET="smkn10_makassar_sarpras_secret_key_super_secure_2026"

# Next.js App URL (for Barcode / QR Code absolute link URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
